{
  "name": "pos-pro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "check": "tsc --noEmit",
    "db:generate": "node scripts/prisma-env.cjs generate",
    "db:migrate": "node scripts/prisma-env.cjs migrate dev",
    "db:deploy": "node scripts/prisma-env.cjs migrate deploy",
    "test:auth": "node --test tests/auth-permissions.test.cjs",
    "test:registration": "node --test tests/owner-registration.test.cjs",
    "test:menu-images": "node --test tests/menu-image.test.cjs",
    "test:menu-images:db": "node --test tests/menu-image-route.test.cjs",
    "test:auth:db": "node --test tests/auth-db.test.cjs",
    "test:inventory": "node --test tests/inventory.test.cjs",
    "test:inventory:db": "node --test tests/inventory-db.test.cjs",
    "test:printing": "node --test print-agent/test/*.test.cjs",
    "test:printing:db": "node --test tests/printing-db.test.cjs",
    "test:sales:db": "node --test tests/sales-db.test.cjs",
    "test:rate-limit": "node --test tests/rate-limit.test.cjs",
    "test:table-session:db": "node --test tests/table-session-db.test.cjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/client": "^6.19.2",
    "@types/qrcode": "^1.5.6",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.35.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "prisma": "^6.19.2",
    "typescript": "^5.9.0"
  }
}
