# Copy this file to .env.local and set the pooled connection string from Neon.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require"

# Required only when the first organization is created from a production deployment.
INITIAL_SETUP_TOKEN="replace-with-another-long-random-secret"

# Public address encoded in table QR codes. Use your production domain or this computer's LAN URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set true only for local/test or Vercel Preview to accept synthetic tax IDs.
# Production deployments always enforce Thai taxpayer ID validation.
TAX_PROFILE_TEST_MODE="false"
